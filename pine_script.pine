//@version=5
// max_bars_back: mesh_bars references green_mesh[1] inside a var reassignment,
// alongside EMA200 and a weekly request.security. On symbols with thin history
// Pine can otherwise throw "requested historical offset is beyond the historical
// buffer's limit" — and when the script errors, NOTHING renders, dashboard
// included. Declaring the buffer explicitly removes that failure mode.
strategy("NSE Swing v6 – Pro UI",
     overlay=true,
     max_bars_back=1000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=2,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=2)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
grp_ema  = "Trend EMAs"
e21_len  = input.int(21,  "EMA 21",  group=grp_ema)
e50_len  = input.int(50,  "EMA 50",  group=grp_ema)
e200_len = input.int(200, "EMA 200", group=grp_ema)

grp_fil  = "Filters"
rsi_len  = input.int(14,    "RSI Length",          group=grp_fil)
adx_len  = input.int(14,    "ADX Length",          group=grp_fil)
adx_long = input.int(18,    "Min ADX – Longs",     group=grp_fil)
adx_short= input.int(20,    "Min ADX – Shorts",    group=grp_fil)
vol_len  = input.int(20,    "Volume MA Length",    group=grp_fil)
vol_long = input.float(1.1, "Volume mult – Longs", group=grp_fil, step=0.05)
vol_short= input.float(1.3, "Volume mult – Shorts",group=grp_fil, step=0.1)

grp_htf  = "Higher Timeframe"
use_htf  = input.bool(true, "Enable Weekly soft filter", group=grp_htf)

grp_risk = "Risk Management"
atr_len      = input.int(14,    "ATR Length",             group=grp_risk)
sl_mult      = input.float(1.5, "SL  (ATR×)",             group=grp_risk, step=0.1)
tp_mult_long = input.float(3.5, "TP  (ATR×) – Longs",    group=grp_risk, step=0.1)
tp_short     = input.float(2.25,"TP  (ATR×) – Shorts",   group=grp_risk, step=0.1)
// Trailing stop is OFF by default so this chart matches the Python backtester,
// which removed it (backtester.py: "Exit logic: MeshBreak -> SL -> TP, trailing
// stop removed"). Every validated figure — Sharpe ~1.1, alpha +10.1%/yr, and the
// 517-trade paper-trading match — describes the no-trail logic. Turning this on
// makes the chart a DIFFERENT strategy from the one that was tested.
use_trail    = input.bool(false,"Trailing stop (off = matches backtest)",
                                                          group=grp_risk)
trail_atr    = input.float(1.0, "Trail activates (ATR×)", group=grp_risk, step=0.1)
trail_offset = input.float(1.5, "Trail offset  (ATR×)",   group=grp_risk, step=0.1)

grp_disp = "Display"
compact     = input.bool(true,  "Compact dashboard (fits short panes)", group=grp_disp)
show_marks  = input.bool(true,  "Entry / exit labels",                  group=grp_disp)
label_full  = input.bool(false, "Verbose labels (price + score)",       group=grp_disp)
show_zones  = input.bool(false, "Shade risk / reward zones",            group=grp_disp)
show_bg     = input.bool(false, "Tint background while in a trade",     group=grp_disp)
// NOTE: TradingView draws its OWN entry/exit arrows and the "-5 TP" quantity
// tags from the strategy engine. Pine cannot suppress those. Turn them off in
// Strategy Settings -> Properties -> uncheck "Signal labels" / "Trades on
// chart", otherwise they stack on top of the labels below.

grp_entry = "Entry Settings"
use_pb    = input.bool(true,   "Enable Pullback entries",  group=grp_entry)
use_bo    = input.bool(true,   "Enable Breakout entries",  group=grp_entry)
bo_period = input.int(12,     "Breakout lookback (bars)", group=grp_entry)
pb_tol    = input.float(1.008, "Pullback zone tolerance",  group=grp_entry, step=0.001)

grp_regime = "Market Regime Filter"
use_regime   = input.bool(true,        "Enable regime filter",       group=grp_regime)
nifty_sym    = input.symbol("NSE:NIFTY","Nifty50 symbol",            group=grp_regime)
regime_ema   = input.int(200,          "Regime EMA period",          group=grp_regime)

grp_base  = "Flat Base Breakout"
base_period   = input.int(15,  "Base min bars",        group=grp_base)
max_range_pct = input.float(5.0,"Max range %",          group=grp_base, step=0.5)
base_vol_mult = input.float(1.2,"Base breakout vol ×",  group=grp_base, step=0.05)

grp_short = "Short Filters"
room_bars    = input.int(50,    "Swing low lookback",       group=grp_short)
min_room_atr = input.float(3.0, "Min room to fall (ATR×)", group=grp_short, step=0.1)
di_gap_min   = input.float(5.0, "Min DI- lead over DI+",   group=grp_short, step=0.5)

// ─── CALCULATIONS ─────────────────────────────────────────────────────────────
ema21  = ta.ema(close, e21_len)
ema50  = ta.ema(close, e50_len)
ema200 = ta.ema(close, e200_len)

rsi    = ta.rsi(close, rsi_len)
[diplus, diminus, adx_val] = ta.dmi(adx_len, adx_len)
atr    = ta.atr(atr_len)
vol_ma = ta.sma(volume, vol_len)

// ─── WEEKLY SOFT FILTER ───────────────────────────────────────────────────────
weekly_ema50 = request.security(syminfo.tickerid, "W",
                 ta.ema(close, 50), lookahead=barmerge.lookahead_off)
weekly_bull  = close > weekly_ema50
weekly_bear  = close < weekly_ema50

rsi_pb_long_lo = use_htf and not weekly_bull ? 43 : 35
rsi_pb_long_hi = use_htf and not weekly_bull ? 57 : 62
rsi_bo_long_lo = use_htf and not weekly_bull ? 53 : 48
rsi_bo_long_hi = use_htf and not weekly_bull ? 70 : 75

// ─── MESH STATE ───────────────────────────────────────────────────────────────
green_mesh        = ema21 > ema50
red_mesh          = ema21 < ema50
mesh_breaks_red   = ta.crossunder(ema21, ema50)
mesh_breaks_green = ta.crossover(ema21, ema50)

// ─── MESH DURATION COUNTER ────────────────────────────────────────────────────
var int mesh_bars = 0
if green_mesh
    mesh_bars := green_mesh[1] ? mesh_bars + 1 : 1
else
    mesh_bars := red_mesh[1] ? mesh_bars + 1 : 1

// ─── 3H TREND ─────────────────────────────────────────────────────────────────
ema21_slope = ema21 - ema21[5]
ema50_slope = ema50 - ema50[5]

bull_trend = green_mesh and ema50 > ema200
             and ema21_slope > 0 and ema50_slope > 0
bear_trend = red_mesh and ema50 < ema200
             and ema21_slope < 0 and ema50_slope < 0

// ─── SHARED ───────────────────────────────────────────────────────────────────
no_pos       = strategy.position_size == 0
in_long      = strategy.position_size > 0
in_short     = strategy.position_size < 0
adx_ok_long  = adx_val >= adx_long
adx_ok_short = adx_val >= adx_short
vol_ok_long  = volume  >= vol_ma * vol_long
vol_ok_short = volume  >= vol_ma * vol_short

// ─── CANDLE QUALITY ───────────────────────────────────────────────────────────
candle_bull    = close > open and
                 (close - low) / math.max(high - low, 0.001) >= 0.50
candle_bear    = close < open and
                 (high - close) / math.max(high - low, 0.001) >= 0.50
bo_candle_bull = close > open and close >= high * 0.96
bo_candle_bear = close < open and close <= low  * 1.04

// ─── MARKET REGIME FILTER ────────────────────────────────────────────────────
// One tuple call instead of three separate round-trips: fewer requests, and the
// three values are guaranteed to come from the same fetch. If the Nifty feed has
// not loaded yet these are na — hence the na guard on regime_ok below, without
// which a cold cache silently blocks every long entry.
[nifty_close, nifty_ema200, nifty_ema50] = request.security(
     nifty_sym, "D",
     [close, ta.ema(close, regime_ema), ta.ema(close, 50)],
     lookahead=barmerge.lookahead_off)

// Three-state market regime:
// BULL     = Nifty above EMA200 AND EMA50 above EMA200 (clear uptrend)
// BEAR     = Nifty below EMA200 (below long-term MA)
// SIDEWAYS = Nifty above EMA200 but EMA50 below EMA200 (no clear direction)
market_bull     = nifty_close > nifty_ema200 and nifty_ema50 > nifty_ema200
market_bear     = nifty_close < nifty_ema200
market_sideways = not market_bull and not market_bear
// na(nifty_close): if the Nifty feed hasn't arrived, fail OPEN rather than
// silently suppressing every signal on the chart.
regime_ok       = not use_regime or na(nifty_close) or market_bull

// ─── FLAT BASE DETECTION ──────────────────────────────────────────────────────
base_high_prev = ta.highest(high, base_period)[1]
base_low_prev  = ta.lowest(low,  base_period)[1]
base_rng_pct   = (base_high_prev - base_low_prev) / close[1] * 100.0
in_flat_base   = base_rng_pct < max_range_pct

vol_in_base    = ta.sma(volume, base_period)
vol_before     = ta.sma(volume[base_period], base_period)
vol_contracting = vol_in_base < vol_before * 0.85
base_quality   = (base_rng_pct < max_range_pct / 2 ? 1 : 0) + (vol_contracting ? 1 : 0)

// ─── SIGNAL STRENGTH SCORE ────────────────────────────────────────────────────
// 7-point scale — score_support replaces RSI component for BASE-BO
score_trend   = bull_trend          ? 1 : 0
score_adx     = adx_ok_long         ? 1 : 0
score_vol     = vol_ok_long         ? 1 : 0
score_rsi_pb  = (rsi >= rsi_pb_long_lo and rsi <= rsi_pb_long_hi) ? 1 : 0
score_candle  = candle_bull         ? 1 : 0
score_weekly  = weekly_bull         ? 1 : 0
score_base    = math.min(base_quality, 2)
signal_score  = score_trend + score_adx + score_vol + score_rsi_pb + score_candle + score_weekly + score_base

score_trend_s  = bear_trend         ? 1 : 0
score_adx_s    = adx_ok_short       ? 1 : 0
score_vol_s    = vol_ok_short       ? 1 : 0
score_rsi_s    = (rsi >= 45 and rsi <= 60) ? 1 : 0
score_candle_s = candle_bear        ? 1 : 0
score_weekly_s = weekly_bear        ? 1 : 0
signal_score_s = score_trend_s + score_adx_s + score_vol_s + score_rsi_s
                 + score_candle_s + score_weekly_s

// ─── LONG SIGNALS ─────────────────────────────────────────────────────────────
pb_zone_long    = low <= ema21 * pb_tol and close > ema21
rsi_pb_long     = rsi >= rsi_pb_long_lo and rsi <= rsi_pb_long_hi
pullback_long   = use_pb and bull_trend and pb_zone_long and rsi_pb_long
                  and candle_bull and adx_ok_long and vol_ok_long

swing_high      = ta.highest(high, bo_period)[1]
rsi_bo_long     = rsi >= rsi_bo_long_lo and rsi <= rsi_bo_long_hi
breakout_long   = use_bo and bull_trend and close > swing_high
                  and rsi_bo_long and bo_candle_bull and adx_ok_long and vol_ok_long

// BASE-BO: breakout from a flat base (≥15 bars, range <5%, volume expansion)
base_bo_long = use_bo and bull_trend and in_flat_base[1] and
               close > base_high_prev and
               rsi >= rsi_bo_long_lo and rsi <= rsi_bo_long_hi and
               bo_candle_bull and adx_ok_long and
               volume >= vol_ma * vol_long * base_vol_mult

buy_signal = (pullback_long or base_bo_long or breakout_long) and no_pos and regime_ok

// ─── SHORT SIGNALS ────────────────────────────────────────────────────────────
di_dominance   = diminus - diplus >= di_gap_min
swing_low_ref  = ta.lowest(low, room_bars)
room_to_fall   = (close - swing_low_ref) >= atr * min_room_atr

pb_zone_short  = high >= ema21 * 0.997 and close < ema21
rsi_pb_short   = rsi >= 45 and rsi <= 60
pullback_short = use_pb and bear_trend and pb_zone_short and rsi_pb_short
                 and candle_bear and adx_ok_short and vol_ok_short
                 and di_dominance and room_to_fall

swing_low_bo   = ta.lowest(low, bo_period)[1]
rsi_bo_short   = rsi >= 30 and rsi <= 50
breakout_short = use_bo and bear_trend and close < swing_low_bo
                 and rsi_bo_short and bo_candle_bear
                 and adx_ok_short and vol_ok_short
                 and di_dominance and room_to_fall

sell_signal = (pullback_short or breakout_short) and no_pos

// ─── SCORE FILTER — only show signal if score is better than open trade ────────
// Prevents chart clutter: same or lower score while already in position = skip.
// Flat position → always show. Better score while in position → show (upgrade).
var int _open_long_score  = 0
var int _open_short_score = 0

// Reset scores when position closes
if not in_long  and not buy_signal
    _open_long_score  := 0
if not in_short and not sell_signal
    _open_short_score := 0

// A signal is "worth showing" only if it improves on the current open trade score
show_long  = buy_signal  and (not in_long  or signal_score   > _open_long_score)
show_short = sell_signal and (not in_short or signal_score_s > _open_short_score)

// Setup name, defined here because strategy.entry() below uses it as its order
// comment and Pine requires declaration before use.
long_type  = pullback_long  ? "PB-L" : base_bo_long ? "BASE-BO" : "BO-L"
short_type = pullback_short ? "PB-S" : "BO-S"

// Track score of current open trade
if show_long
    _open_long_score  := signal_score
if show_short
    _open_short_score := signal_score_s

// ─── TRAILING STOP LOGIC (unchanged) ──────────────────────────────────────────
var float entry_price    = na
var float trail_high     = na
var float trail_low      = na
var bool  trail_active_l = false
var bool  trail_active_s = false

if show_long
    entry_price    := close
    trail_high     := close
    trail_active_l := false

if show_short
    entry_price    := close
    trail_low      := close
    trail_active_s := false

if in_long
    trail_high := math.max(trail_high, high)
    if trail_high >= entry_price + atr * trail_atr
        trail_active_l := true

if in_short
    trail_low := math.min(trail_low, low)
    if trail_low <= entry_price - atr * trail_atr
        trail_active_s := true

trail_sl_long  = trail_active_l ? trail_high - atr * trail_offset : na
trail_sl_short = trail_active_s ? trail_low  + atr * trail_offset : na

// ─── EXITS ────────────────────────────────────────────────────────────────────
// Each exit records WHY it fired and at WHAT price, so the chart can draw a
// readable marker instead of TradingView's default "-10 SL" quantity tag.
// Fill assumption matches the exit test: SL/TP fill AT the level, mesh and
// trail exits fill at the close.
// Plain (non-var) locals: they reset to these defaults on every bar, so no
// manual clearing is needed and a stale exit can never be redrawn.
string exit_why    = ""
float  exit_px     = na
float  exit_pnl    = na
bool   exit_was_lg = false

if in_long
    sl_price = entry_price - atr * sl_mult
    tp_price = entry_price + atr * tp_mult_long
    if mesh_breaks_red
        strategy.close("Long", comment="Mesh")
        exit_why := "MESH"
        exit_px  := close
    else if use_trail and trail_active_l and low <= trail_sl_long
        strategy.close("Long", comment="Trail")
        exit_why := "TRAIL"
        exit_px  := trail_sl_long
    else if low <= sl_price
        strategy.close("Long", comment="SL")
        exit_why := "STOP"
        exit_px  := sl_price
    else if high >= tp_price
        strategy.close("Long", comment="TP")
        exit_why := "TARGET"
        exit_px  := tp_price
    if exit_why != ""
        exit_was_lg := true
        exit_pnl    := (exit_px / entry_price - 1) * 100

if in_short
    sl_price = entry_price + atr * sl_mult
    tp_price = entry_price - atr * tp_short
    if mesh_breaks_green
        strategy.close("Short", comment="Mesh")
        exit_why := "MESH"
        exit_px  := close
    else if use_trail and trail_active_s and high >= trail_sl_short
        strategy.close("Short", comment="Trail")
        exit_why := "TRAIL"
        exit_px  := trail_sl_short
    else if high >= sl_price
        strategy.close("Short", comment="SL")
        exit_why := "STOP"
        exit_px  := sl_price
    else if low <= tp_price
        strategy.close("Short", comment="TP")
        exit_why := "TARGET"
        exit_px  := tp_price
    if exit_why != ""
        exit_pnl := (entry_price / exit_px - 1) * 100

// ─── ENTRIES (unchanged) ──────────────────────────────────────────────────────
if show_long
    strategy.entry("Long", strategy.long,
         comment = long_type)

if show_short
    strategy.entry("Short", strategy.short,
         comment = short_type)

// ═══════════════════════════════════════════════════════════════════════════════
// PRO UI LAYER — all visual additions below, zero logic change above
// ═══════════════════════════════════════════════════════════════════════════════

// ─── EMA PLOTS ────────────────────────────────────────────────────────────────
e21_plot = plot(ema21,  "EMA 21",  color=color.new(color.green,  0), linewidth=2)
e50_plot = plot(ema50,  "EMA 50",  color=color.new(color.blue,   0), linewidth=2)
e200_plot = plot(ema200, "EMA 200", color=color.new(color.red,    0), linewidth=2)
weeklyema50 = plot(weekly_ema50, "W EMA50", color=color.new(color.orange, 30), linewidth=1, style=plot.style_circles)

// ─── MESH FILL ────────────────────────────────────────────────────────────────
fill(e21_plot, e50_plot,
     color = green_mesh ? color.new(color.green, 82) :
             red_mesh   ? color.new(color.red,   82) : na,
     title = "EMA Mesh")

// ─── BACKGROUND TINT WHEN IN TRADE ───────────────────────────────────────────
bgcolor(not show_bg ? na :
        in_long  ? color.new(color.green, 95) :
        in_short ? color.new(color.red,   95) : na, title="Trade Background")

// ─── EMA STRUCTURE LABELS ─────────────────────────────────────────────────────
// These appear when EMA21 crosses EMA50 — shows structure change, NOT a trade.
// They are small and informational only.
// The actual LONG / SHORT trade entries are the large triangles below.
plotshape(mesh_breaks_green, "EMA 21 > 50",
          shape.labelup, location.belowbar,
          color.new(color.teal, 30),
          text="EMA 21>50", textcolor=color.white, size=size.tiny)

plotshape(mesh_breaks_red, "EMA 21 < 50",
          shape.labeldown, location.abovebar,
          color.new(color.maroon, 30),
          text="EMA 21<50", textcolor=color.white, size=size.tiny)

// Mesh-break exits used to get their own marker here. They are now covered by
// the unified EXIT label further down, which also carries the P&L — two markers
// on the same bar was just clutter.

// ─── TRADE ENTRY SIGNALS ──────────────────────────────────────────────────────
// LARGE triangles = actual trade signals (rare, all conditions met)
// LONG  ▲ = green triangle at bottom — entry point to BUY
// SHORT ▼ = red triangle at top    — entry point to SELL SHORT
// Label shows: LONG/SHORT | price | score | signal type (PB-L, BO-L etc.)
// show_long stays true while a position is open whenever a higher-scoring
// signal appears (that is what re-arms the entry). Marking every one of those
// stacks three or four labels over the same trade. Only the bar that actually
// OPENS a position gets a mark.
fresh_long  = show_long  and not in_long
fresh_short = show_short and not in_short

// Compact by default: the setup type and score are what you act on. The price
// is already on the axis and the % is on the exit label.

long_label  = label_full ?
     "LONG  ₹" + str.tostring(math.round(close, 2)) +
     "  " + str.tostring(signal_score) + "/7  " + long_type :
     long_type + "  " + str.tostring(signal_score) + "/7"

short_label = label_full ?
     "SHORT  ₹" + str.tostring(math.round(close, 2)) +
     "  " + str.tostring(signal_score_s) + "/6  " + short_type :
     short_type + "  " + str.tostring(signal_score_s) + "/6"

plotshape(fresh_long,  "LONG Entry",
          shape.triangleup, location.belowbar,
          color.new(color.lime, 0), text="", size=size.tiny)

plotshape(fresh_short, "SHORT Entry",
          shape.triangledown, location.abovebar,
          color.new(color.red, 0), text="", size=size.tiny)

if show_marks and fresh_long
    label.new(bar_index, low - atr * 0.4,
         text=long_label,
         color=color.new(color.green, 25),
         textcolor=color.white,
         style=label.style_label_up,
         size=size.tiny)

if show_marks and fresh_short
    label.new(bar_index, high + atr * 0.4,
         text=short_label,
         color=color.new(color.red, 25),
         textcolor=color.white,
         style=label.style_label_down,
         size=size.tiny)

// ─── TRADE ZONES: where you get out, drawn while you are still in ────────────
// Three lines plus two shaded bands. The green band is everything between your
// entry and your target; the red band is entry down to your stop. While a trade
// is open you can see both exits and their distance at a glance, instead of
// hunting for a 1px dotted line.
lvl_entry = in_long or in_short ? entry_price : na
lvl_sl    = in_long  ? entry_price - atr * sl_mult :
            in_short ? entry_price + atr * sl_mult : na
lvl_tp    = in_long  ? entry_price + atr * tp_mult_long :
            in_short ? entry_price - atr * tp_short : na

p_entry = plot(lvl_entry, "Entry",  color.new(color.gray,  20),
               style=plot.style_linebr, linewidth=2)
p_sl    = plot(lvl_sl,    "Stop",   color.new(color.red,    0),
               style=plot.style_linebr, linewidth=2)
p_tp    = plot(lvl_tp,    "Target", color.new(color.green,  0),
               style=plot.style_linebr, linewidth=2)

// Off by default — the shaded bands read well on a single trade and turn into
// noise on a chart with twenty of them.
fill(p_entry, p_tp, show_zones ? color.new(color.green, 90) : na, title="Reward zone")
fill(p_entry, p_sl, show_zones ? color.new(color.red,   90) : na, title="Risk zone")

plot(use_trail and in_long  and trail_active_l ? trail_sl_long  : na, "Trail Long",
     color.new(color.orange, 0), style=plot.style_linebr, linewidth=2)
plot(use_trail and in_short and trail_active_s ? trail_sl_short : na, "Trail Short",
     color.new(color.orange, 0), style=plot.style_linebr, linewidth=2)

// Price tags on the live levels, so the exact rupee figure is readable without
// tracing the line across to the axis.
var label tag_sl = na
var label tag_tp = na
if barstate.islast and show_marks
    label.delete(tag_sl)
    label.delete(tag_tp)
    if in_long or in_short
        tag_sl := label.new(bar_index + 3, lvl_sl,
             "STOP  ₹" + str.tostring(math.round(lvl_sl, 2)) +
             "  (" + str.tostring(math.round((lvl_sl / entry_price - 1) * 100, 1)) + "%)",
             color=color.new(color.red, 20), textcolor=color.white,
             style=label.style_label_left, size=size.small)
        tag_tp := label.new(bar_index + 3, lvl_tp,
             "TARGET  ₹" + str.tostring(math.round(lvl_tp, 2)) +
             "  (" + str.tostring(math.round((lvl_tp / entry_price - 1) * 100, 1)) + "%)",
             color=color.new(color.green, 20), textcolor=color.white,
             style=label.style_label_left, size=size.small)

// ─── EXIT MARKERS ─────────────────────────────────────────────────────────────
// Coloured by OUTCOME, not by reason: green label = you made money on this
// trade, red = you lost. The reason and the P&L are both on the label, so a
// closed trade reads without opening the strategy tester.
if show_marks and exit_why != ""
    won = exit_pnl > 0
    label.new(bar_index, exit_was_lg ? high + atr * 0.4 : low - atr * 0.4,
         text = label_full ?
              exit_why + "  ₹" + str.tostring(math.round(exit_px, 2)) + "  " +
              (exit_pnl >= 0 ? "+" : "") + str.tostring(math.round(exit_pnl, 1)) + "%" :
              (exit_pnl >= 0 ? "+" : "") + str.tostring(math.round(exit_pnl, 1)) + "%",
         color     = won ? color.new(color.teal, 20) : color.new(color.maroon, 20),
         textcolor = color.white,
         style     = exit_was_lg ? label.style_label_down : label.style_label_up,
         size      = size.tiny)

plotshape(exit_why != "" and exit_was_lg,  "Exit Long",
          shape.xcross, location.abovebar, color.new(color.white, 0), size=size.tiny)
plotshape(exit_why != "" and not exit_was_lg, "Exit Short",
          shape.xcross, location.belowbar, color.new(color.white, 0), size=size.tiny)

// ─── PROFESSIONAL DASHBOARD TABLE ─────────────────────────────────────────────
// Bigger, cleaner, sectioned — dark theme
// TradingView renders tables inside the chart pane and DROPS one that exceeds
// the available height rather than clipping it — which is why an 18-row table
// appears on a tall pane and vanishes on a short one. Compact mode keeps the
// first 10 rows (through the signal block) so it always fits.
// Capacity stays 18; unwritten rows are simply not drawn, so compact mode
// shortens the rendered table without needing a second table object.
var table dash = table.new(position.top_right, 3, 18,
     frame_width=2, frame_color=color.new(color.gray, 40),
     border_width=1, border_color=color.new(color.gray, 60),
     bgcolor=color.new(color.black, 70))

// helper: row background colours
col_header = color.new(color.gray,   50)
col_section = color.new(color.gray,  70)
col_val_neu = color.new(color.black, 70)

if barstate.islast

    // ── HEADER ROW ────────────────────────────────────────────────────────────
    table.cell(dash, 0, 0, "NSE SWING v6",
         bgcolor=color.new(color.blue, 30),
         text_color=color.white, text_size=size.normal,
         text_halign=text.align_center)
    table.cell(dash, 1, 0,
         syminfo.ticker + "  ₹" + str.tostring(math.round(close, 2)),
         bgcolor=color.new(color.blue, 30),
         text_color=color.new(color.gray, 20),
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 0, green_mesh ? "GREEN MESH" : "RED MESH",
         bgcolor = green_mesh ? color.new(color.green, 30) :
                               color.new(color.red,   30),
         text_color=color.white, text_size=size.small,
         text_halign=text.align_center)

    // ── SECTION: MARKET CONTEXT ───────────────────────────────────────────────
    table.cell(dash, 0, 1, "MARKET CONTEXT",
         bgcolor=col_section, text_color=color.new(color.gray, 10),
         text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, "", bgcolor=col_section)
    table.cell(dash, 2, 1, "", bgcolor=col_section)

    table.cell(dash, 0, 2, "3H Trend",
         text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(dash, 1, 2, bull_trend ? "LONG SETUP" : bear_trend ? "SHORT SETUP" : "NO SETUP",
         text_color = bull_trend ? color.lime : bear_trend ? color.red : color.gray,
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 2,
         bull_trend ? "EMA21>50>200 ↑" : bear_trend ? "EMA21<50<200 ↓" : "EMAs mixed",
         text_color=color.new(color.gray, 30), text_size=size.tiny)

    table.cell(dash, 0, 3, "Nifty regime",
         text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(dash, 1, 3,
         market_bull ? "BULL" : market_bear ? "BEAR" : "SIDEWAYS",
         text_color = market_bull ? color.lime : market_bear ? color.red : color.orange,
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 3,
         market_bull ? "Nifty above EMA50>200" :
         market_bear ? "Nifty below EMA200"    : "Nifty EMA50<200",
         text_color=color.new(color.gray, 30), text_size=size.tiny)

    table.cell(dash, 0, 4, "Mesh duration",
         text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(mesh_bars) + " bars",
         text_color = mesh_bars >= 10 ? color.lime :
                      mesh_bars >= 5  ? color.orange : color.gray,
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 4,
         mesh_bars >= 10 ? "Strong trend" :
         mesh_bars >= 5  ? "Developing"   : "Early",
         text_color=color.new(color.gray, 30), text_size=size.tiny)

    // ── SECTION: INDICATORS ───────────────────────────────────────────────────
    table.cell(dash, 0, 5, "INDICATORS",
         bgcolor=col_section, text_color=color.new(color.gray, 10),
         text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, "", bgcolor=col_section)
    table.cell(dash, 2, 5, "", bgcolor=col_section)

    table.cell(dash, 0, 6, "ADX",
         text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(math.round(adx_val, 1)),
         text_color = adx_val >= adx_short ? color.lime :
                      adx_val >= adx_long  ? color.orange : color.red,
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 6,
         adx_val >= 30 ? "Strong" : adx_val >= 20 ? "Moderate" : "Weak",
         text_color=color.new(color.gray, 30), text_size=size.tiny)

    table.cell(dash, 0, 7, "RSI",
         text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(dash, 1, 7, str.tostring(math.round(rsi, 1)),
         text_color = rsi >= 70 ? color.red :
                      rsi <= 30 ? color.lime : color.white,
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 7,
         rsi >= 70 ? "Overbought" : rsi <= 30 ? "Oversold" : "Neutral",
         text_color=color.new(color.gray, 30), text_size=size.tiny)

    table.cell(dash, 0, 8, "DI- lead",
         text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(dash, 1, 8,
         str.tostring(math.round(diminus - diplus, 1)),
         text_color = (diminus - diplus) >= di_gap_min ? color.lime : color.red,
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 8,
         (diminus - diplus) >= di_gap_min ? "Bear dominant" : "Not dominant",
         text_color=color.new(color.gray, 30), text_size=size.tiny)

    table.cell(dash, 0, 9, "Volume",
         text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(dash, 1, 9, vol_ok_long ? "YES" : "NO",
         text_color = vol_ok_long ? color.lime : color.red,
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 9,
         str.tostring(math.round(volume / vol_ma, 2)) + "x avg",
         text_color=color.new(color.gray, 30), text_size=size.tiny)

    // ── SECTION: SIGNAL ───────────────────────────────────────────────────────
    table.cell(dash, 0, 10, "SIGNAL",
         bgcolor=col_section, text_color=color.new(color.gray, 10),
         text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 10, "", bgcolor=col_section)
    table.cell(dash, 2, 10, "", bgcolor=col_section)

    table.cell(dash, 0, 11, "Signal score",
         text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(dash, 1, 11,
         str.tostring(in_short ? signal_score_s : signal_score) +
         (in_short ? " / 6" : " / 7"),
         text_color = (in_short ? signal_score_s : signal_score) >= 5 ? color.lime :
                      (in_short ? signal_score_s : signal_score) >= 3 ? color.orange : color.red,
         text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 2, 11,
         (in_short ? signal_score_s >= 5 : signal_score >= 6) ? "High conviction" :
         (in_short ? signal_score_s >= 3 : signal_score >= 4) ? "Moderate"        : "Low",
         text_color=color.new(color.gray, 30), text_size=size.tiny)

    table.cell(dash, 0, 12, "ATR",
         text_color=color.new(color.gray, 20), text_size=size.small)
    table.cell(dash, 1, 12, str.tostring(math.round(atr, 2)),
         text_color=color.white, text_size=size.small,
         text_halign=text.align_center)
    table.cell(dash, 2, 12,
         str.tostring(math.round(atr / close * 100, 2)) + "% of price",
         text_color=color.new(color.gray, 30), text_size=size.tiny)

    // ── SECTION: TRADE ────────────────────────────────────────────────────────
    // Compact mode stops here. The TRADE block is the least-read part of the
    // dashboard, and dropping it keeps the table short enough that TradingView
    // still renders it on a short pane instead of discarding the whole thing.
    if not compact
        table.cell(dash, 0, 13, "TRADE",
             bgcolor=col_section, text_color=color.new(color.gray, 10),
             text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, 13, "", bgcolor=col_section)
        table.cell(dash, 2, 13, "", bgcolor=col_section)

        table.cell(dash, 0, 14, "Position",
             text_color=color.new(color.gray, 20), text_size=size.small)
        table.cell(dash, 1, 14,
             in_long  ? "LONG"  :
             in_short ? "SHORT" : "FLAT",
             text_color = in_long  ? color.lime :
                          in_short ? color.red  : color.gray,
             text_size=size.normal, text_halign=text.align_center)
        table.cell(dash, 2, 14,
             in_long or in_short ? "Active trade" : "Waiting for signal",
             text_color=color.new(color.gray, 30), text_size=size.tiny)

        table.cell(dash, 0, 15, "Entry price",
             text_color=color.new(color.gray, 20), text_size=size.small)
        table.cell(dash, 1, 15,
             (in_long or in_short) and not na(entry_price) ?
                 str.tostring(math.round(entry_price, 2)) : "–",
             text_color = in_long  ? color.lime :
                          in_short ? color.red  : color.gray,
             text_size=size.small, text_halign=text.align_center)
        table.cell(dash, 2, 15,
             in_long  and not na(entry_price) ?
                 "SL " + str.tostring(math.round(entry_price - atr * sl_mult, 2)) :
             in_short and not na(entry_price) ?
                 "SL " + str.tostring(math.round(entry_price + atr * sl_mult, 2)) : "–",
             text_color=color.new(color.red, 10), text_size=size.tiny)

        table.cell(dash, 0, 16, "Trail active",
             text_color=color.new(color.gray, 20), text_size=size.small)
        table.cell(dash, 1, 16,
             (in_long or in_short) ?
                 (trail_active_l or trail_active_s ? "YES" : "NO") : "–",
             text_color = trail_active_l or trail_active_s ? color.lime : color.gray,
             text_size=size.small, text_halign=text.align_center)
        table.cell(dash, 2, 16,
             in_long  and trail_active_l ?
                 "@ " + str.tostring(math.round(trail_sl_long,  2)) :
             in_short and trail_active_s ?
                 "@ " + str.tostring(math.round(trail_sl_short, 2)) : "–",
             text_color=color.new(color.orange, 10), text_size=size.tiny)

        table.cell(dash, 0, 17, "Mesh bars",
             text_color=color.new(color.gray, 20), text_size=size.small)
        table.cell(dash, 1, 17, str.tostring(mesh_bars),
             text_color = green_mesh ? color.lime : color.red,
             text_size=size.small, text_halign=text.align_center)
        table.cell(dash, 2, 17,
             green_mesh ? "Green since " + str.tostring(mesh_bars) + "b" :
                          "Red since "   + str.tostring(mesh_bars) + "b",
             text_color=color.new(color.gray, 30), text_size=size.tiny)
